# FE-Kiosk-Medical .env.local template
# Copy to .env.local and fill real values. .env.local is gitignored.

# Backend gateway base URLs
# When no Kong gateway: point directly to chat-service (8082) and core-service (8083)
NEXT_PUBLIC_API_PATH=http://127.0.0.1:8082
NEXT_PUBLIC_MAP_API_BASE=http://127.0.0.1:8083

# Cloudinary (for map background image upload)
# Leave empty if not using map editor's image upload feature
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# TTS (Text-to-Speech) endpoint
# Default points to production hosted TTS - requires internet
TTS_API_URL=https://medicagent.cybertech.com.vn/tts

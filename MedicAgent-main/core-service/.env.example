# core-service .env template
# Copy to .env and fill real values. .env is gitignored.

# MySQL connection (directory + queue DBs)
DB_USER=medicagent
DB_PASSWORD=change_me_password
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=medicagent-directory-db
DIRECTORY_DB_NAME=medicagent-directory-db
QUEUE_DB_NAME=medicagent-queue-db

# MongoDB Atlas (used by maps service)
# Get connection string from Atlas dashboard. NEVER commit real credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=map_direction

# Qdrant vector store
QDRANT_ENABLED=true
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6337

# Info lookup ranking weights
INFO_LOOKUP_LEXICAL_WEIGHT=0.1
INFO_LOOKUP_SEMANTIC_WEIGHT=0.7

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=

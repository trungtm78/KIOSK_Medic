# MedicAgent root .env template
# Copy to .env and fill real values. .env is gitignored.

# MySQL container (used by infra-compose.yml)
MYSQL_ROOT_PASSWORD=change_me_rootpassword
MYSQL_USER=medicagent
MYSQL_PASSWORD=change_me_password
MYSQL_DATABASE=medicagent-db

# Shared DB credentials (used by core/chat/admin if they read from root)
DB_USER=medicagent
DB_PASSWORD=change_me_password
DIRECTORY_DB_NAME=medicagent-directory-db
QUEUE_DB_NAME=medicagent-queue-db
ADMIN_DB_NAME=medicagent-admin-db

# Qdrant (vector store for info lookup)
QDRANT_ENABLED=true
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6337

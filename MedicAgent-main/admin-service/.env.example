# admin-service .env template
# Copy to .env and fill real values. .env is gitignored.

ADMIN_DB_URL=mysql+pymysql://medicagent:change_me_password@127.0.0.1:3307/medicagent-admin-db
ENV=development
APP_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=

# CSO Finding #2 fix - admin API key for kiosk token management endpoints
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in production. In development, can be left empty (warning).
ADMIN_API_KEY=

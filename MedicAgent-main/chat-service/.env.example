# chat-service .env template
# Copy to .env and fill real values. .env is gitignored.

# MySQL connection (uses chat_service DB)
CHAT_DB_URL=mysql+pymysql://medicagent:change_me_password@127.0.0.1:3307/chat_service

# Intent classifier model directory (joblib + ONNX artifacts)
INTENT_MODEL_DIR=./models/intent_classifier

# LLM backend (optional - Ollama on port 8084 if running locally with GPU)
LLM_API_BASE=http://127.0.0.1:8084/v1
LLM_MODEL=Jan-nano-128k

# CORS - comma-separated list of allowed origins
# Leave empty for dev defaults (localhost:3000 + 127.0.0.1:3000)
# Production: CORS_ORIGINS=https://kiosk.example.com,https://admin.example.com
CORS_ORIGINS=

# Model caches & large binaries
# ============================================================
model_cache/
*.bin
*.onnx
*.safetensors
*.pt
*.pth
*.joblib

# Allow specific model artifacts (chat-service intent/syndrome classifiers)
!MedicAgent-main/chat-service/models/**/*.joblib
!MedicAgent-main/chat-service/models/**/*.onnx
!MedicAgent-main/chat-service/models/**/config.json
!MedicAgent-main/chat-service/models/**/label_encoder.json

